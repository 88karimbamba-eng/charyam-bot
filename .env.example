# CHARYAM — modèle de configuration. Noms de variables et VALEURS FICTIVES uniquement.
# Ne copiez jamais de vraie clé dans ce fichier ni dans un dépôt : saisissez-les dans
# Render > votre service > Environment (ou dans un fichier .env local, ignoré par git).

# --- Obligatoires (déjà configurées sur Render) ---
TELEGRAM_BOT_TOKEN=123456:exemple-fictif
ANTHROPIC_API_KEY=sk-ant-exemple-fictif

# --- Perplexity : recherche web avec sources (API Search) ---
PERPLEXITY_API_KEY=pplx-exemple-fictif

# --- Firecrawl : lecture de pages / petits sites ---
FIRECRAWL_API_KEY=fc-exemple-fictif
# FIRECRAWL_TIMEOUT_SECONDS=45

# --- Playwright : navigateur. DÉSACTIVÉ par défaut. Il faut les deux lignes (mode + liste blanche) ---
# Recommandé sur Render : un navigateur DISTANT (le Chromium local dépasse la RAM d'une offre 512 Mo)
# PLAYWRIGHT_CDP_URL=wss://navigateur-distant.exemple/?token=exemple-fictif
# Chromium local (seulement sur une machine/offre avec assez de mémoire) :
# PLAYWRIGHT_LOCAL=1
# PLAYWRIGHT_ALLOWED_DOMAINS=exemple.org,autre-exemple.org

# --- Composio : applications connectées, LECTURE SEULE. Les 4 lignes sont nécessaires ---
# COMPOSIO_API_KEY=cmp-exemple-fictif
# COMPOSIO_USER_ID=identifiant-stable-de-l-utilisateur
# COMPOSIO_READONLY_TOOLS=SLUG_OUTIL_LECTURE_1,SLUG_OUTIL_LECTURE_2
# COMPOSIO_TOOL_VERSION=version-precise-de-l-outil   # « latest » est refusé

# --- Limites (facultatives) ---
# TOOL_CALLS_PER_HOUR=60

# --- Accès testeurs et limites (facultatif) ---
# Identifiants Telegram autorisés en plus du propriétaire, séparés par des virgules (valeurs fictives).
ALLOWED_USER_IDS=111111111,222222222
# Limites de messages par testeur (le propriétaire n'est pas limité). Valeurs par défaut : 6 par minute, 60 par jour.
USER_MESSAGES_PER_MINUTE=6
USER_MESSAGES_PER_DAY=60

# --- Sécurité du webhook (OBLIGATOIRE en production, voir docs/WEBHOOK_SECURITE.md) ---
# Valeur aléatoire (32 caractères ou plus ; lettres, chiffres, _ et - seulement). Ne la mettez jamais dans le dépôt.
# TELEGRAM_WEBHOOK_SECRET=
# Hors Render, forcer le mode production : CHARYAM_ENV=production

# --- Mémoire persistante et quotas persistants (facultatif, voir docs/MEMOIRE_PERSISTANTE.md) ---
# Sans ces deux variables : mémoire en RAM, perdue à chaque redémarrage. Valeurs fictives ici.
# UPSTASH_REDIS_REST_URL=https://exemple-fictif.upstash.io
# UPSTASH_REDIS_REST_TOKEN=jeton-fictif

# --- Paiement manuel des clients (voir payments.py) ---
# Sans PAYMENT_INSTRUCTIONS, les clients ne reçoivent AUCUN fichier Word/PDF (le propriétaire, si).
# Texte envoyé au client : prix en FCFA et numéros Mobile Money. À saisir dans Render, pas dans le dépôt.
# PAYMENT_INSTRUCTIONS=Prix : [à compléter] FCFA. Wave : [numéro]. Orange Money : [numéro].
# Durée pendant laquelle un paiement validé permet de télécharger (heures, 1 à 168, défaut 24).
# PAYMENT_VALID_HOURS=24

# --- Accès ouvert aux clients (voir access.py) ---
# Par défaut le bot est OUVERT à tout le monde. OPEN_ACCESS=0 le ferme : seuls le propriétaire et
# ALLOWED_USER_IDS peuvent écrire (retour arrière immédiat).
# OPEN_ACCESS=1
# Plafond de messages par JOUR pour toutes les personnes hors liste réunies (borne la dépense de l'API). Défaut : 300.
# OPEN_DAILY_CAP=300
